# =============================================================================
# .env.example
# -----------------------------------------------------------------------------
# 이 파일을 복사해서 .env 로 만들고 값을 조정하세요.
#   Windows : copy .env.example .env
#   macOS/Linux : cp .env.example .env
#
# 모든 항목에 기본값이 있으므로 .env 없이도 서버는 실행됩니다.
# .env 파일은 Git 에 커밋하지 마세요. (.gitignore 에 등록되어 있습니다)
# =============================================================================

# -----------------------------------------------------------------------------
# 애플리케이션 기본 설정
# -----------------------------------------------------------------------------
APP_NAME=Document AI Backend
APP_ENV=local                 # local | dev | prod
DEBUG=true                    # prod 에서는 반드시 false
API_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# 업로드 제한
# -----------------------------------------------------------------------------
MAX_UPLOAD_MB=20

# -----------------------------------------------------------------------------
# PP-OCRv5 (PaddleOCR) 모델 설정
# -----------------------------------------------------------------------------
# 모델 이름만 바꾸면 코드 수정 없이 다른 PP-OCRv5 모델을 사용할 수 있습니다.
# 모델 가중치는 첫 OCR 요청 때 자동으로 내려받습니다. (~/.paddlex)
#
# 검출(det) 모델 - 글자 영역을 찾는 모델
#   PP-OCRv5_server_det : 정확도 우선 (기본값)
#   PP-OCRv5_mobile_det : 속도 우선
OCR_DET_MODEL=PP-OCRv5_server_det

# 인식(rec) 모델 - 찾은 영역의 글자를 읽는 모델
#   korean_PP-OCRv5_mobile_rec : 한국어 (기본값)
#   PP-OCRv5_server_rec        : 중국어/영어 중심 다국어
#   en_PP-OCRv5_mobile_rec     : 영어 전용
OCR_REC_MODEL=korean_PP-OCRv5_mobile_rec

# 연산 장치. 비워두면 자동 선택. ("cpu" 또는 "gpu:0")
OCR_DEVICE=

# 인식 신뢰도가 이 값보다 낮은 결과는 버립니다. (0.0 ~ 1.0)
OCR_MIN_SCORE=0.5

# PDF 페이지·이미지 영역을 렌더링할 해상도(DPI).
# 높이면 작은 글씨 인식률이 올라가지만 느려집니다. (150 ~ 300 권장)
OCR_DPI=200

# 가로·세로가 이 픽셀보다 작은 이미지는 아이콘·구분선으로 보고 OCR 하지 않습니다.
OCR_MIN_IMAGE_PX=80

# 세로쓰기나 회전된 문서를 다룰 때만 true 로 바꾸세요. (느려집니다)
OCR_USE_TEXTLINE_ORIENTATION=false

# -----------------------------------------------------------------------------
# PDF 처리 방식
# -----------------------------------------------------------------------------
# 페이지에서 뽑은 텍스트가 이 글자 수보다 적으면 "텍스트 없는 스캔 페이지"로 보고
# 페이지 전체를 PP-OCRv5 로 보냅니다.
PDF_MIN_TEXT_CHARS=10

# 텍스트가 있는 페이지에 박힌 이미지도 좌표로 잘라 OCR 할지 여부.
# false 로 두면 PyMuPDF 텍스트만 추출하므로 훨씬 빠릅니다.
PDF_OCR_EMBEDDED_IMAGES=true

# -----------------------------------------------------------------------------
# 로깅
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_DIR=./logs
LOG_TO_FILE=true

# =============================================================================
# 분류 파이프라인 (③ 임베딩 -> ④ 후보 추림 -> ⑤ Qwen 판정)
# =============================================================================

# -----------------------------------------------------------------------------
# 공통 실행 환경
# -----------------------------------------------------------------------------
# auto = CUDA 가 보이면 GPU, 없으면 CPU 로 자동 선택합니다.
# 강제로 지정하려면 cpu / cuda / cuda:0 을 적으세요.
DEVICE=auto

# HuggingFace 모델 캐시 경로. 비우면 기본 경로(~/.cache/huggingface)를 씁니다.
# 폐쇄망이라면 미리 받아둔 폴더를 여기에 지정하세요.
MODEL_CACHE_DIR=

# true 면 서버 기동 시 모델 2개를 미리 올립니다.
# (기동이 수 분 걸리는 대신 첫 요청이 빨라집니다)
PRELOAD_MODELS=false

# ② 추출 원문이 이보다 길면 앞부분만 사용합니다.
PIPELINE_MAX_INPUT_CHARS=4000

# -----------------------------------------------------------------------------
# ②→③ 키워드 3개 + 요약문
# -----------------------------------------------------------------------------
KEYWORD_TOP_K=3                   # 그림의 "키워드 3개"
KEYWORD_USE_MMR=true              # 비슷한 키워드가 겹치지 않게 분산
KEYWORD_MMR_DIVERSITY=0.5         # 0에 가까울수록 정확도, 1에 가까울수록 다양성
SUMMARY_MAX_SENTENCES=3           # TextRank 로 고를 문장 수
SUMMARY_MAX_CHARS=400
SUMMARY_DAMPING=0.85              # PageRank 감쇠 계수
SUMMARY_ITERATIONS=30
QUERY_DROP_BOILERPLATE=true      # ④ 질의문에서 상투 문구 제거 (⑤ 입력은 그대로)
SUMMARY_FULL_TEXT_CHARS=200       # 상투 문구를 뺀 본문이 이 이하면 요약 없이 전부 사용
SUMMARY_KEEP_FIRST=true           # 요약할 때도 첫 문장은 항상 포함

# -----------------------------------------------------------------------------
# ③ 임베딩 (bge-m3)
# -----------------------------------------------------------------------------
# 학습 없이 그대로 사용합니다. 로컬 폴더 경로를 적어도 됩니다.
EMBED_MODEL=BAAI/bge-m3
EMBED_NORMALIZE=true              # L2 정규화 (내적 = 코사인 유사도)
EMBED_BATCH_SIZE=16
EMBED_MAX_SEQ_LENGTH=1024         # 최대 8192. 길수록 느립니다

# -----------------------------------------------------------------------------
# ④ 후보 추림 (카테고리만 좁힘 - 게이트 아님)
# -----------------------------------------------------------------------------
CANDIDATE_TOP_K=3                 # 그림의 "top-3"

# 1위 카테고리 유사도가 이보다 낮으면 candidates.low_confidence=true 로 표시하고
# 아래 벡터DB(라벨링된 사례)를 열어 후보를 재정렬합니다. 반려 기준은 아닙니다. (게이트 참고)
CANDIDATE_MIN_SCORE=0.65         # 학습 노트북 6-1 측정으로 고른 값 (거의 매번 벡터DB 를 엶)

# 카테고리 점수 계산 방식 (학습 노트북 6-1 측정 셀 결과로 고르세요)
#   single : 카테고리 정의문(설명+키워드 전체) 벡터 1개와 비교 (기존 방식)
#   multi  : 정의문 벡터와 키워드 하나하나의 벡터 중 가장 가까운 것의 점수
CANDIDATE_SCORING=multi

# -----------------------------------------------------------------------------
# ④ 보조 : 벡터DB (라벨링된 사례)
# -----------------------------------------------------------------------------
# 비슷한 사례의 카테고리 라벨로 top-3 후보를 다시 정렬한 뒤 ⑤ 에 넘깁니다. (⑤ 프롬프트는 그대로)
# 언제·어떻게 쓸지는 CASE_MODE 로 고릅니다. (학습 노트북 6-1 측정 셀로 비교)
#   low_confidence : ④ 1위 유사도 < CANDIDATE_MIN_SCORE 일 때만 섞기 (기존 방식)
#   always         : 매번 섞기
#   union          : 매번 섞고, 사례 점수 1위 카테고리가 top-3 밖이면 3위 자리에 넣기
#                    (④ 와 사례 중 하나만 맞아도 정답이 후보에 들어감)
#   최종 점수 = (1 - CASE_BLEND_WEIGHT) * ④ 점수 + CASE_BLEND_WEIGHT * 사례 점수
#   사례 점수 = CASE_MIN_SCORE 이상인 사례 중 그 카테고리 라벨의 유사도 합 / CASE_TOP_K
#              (기준을 넘은 사례가 적으면 그만큼 영향이 작아짐)
#
# 서버 기동 시 CSV(컬럼 text, category)를 읽어 같은 폴더에 .npy / .meta.json 을 만듭니다.
# CSV·임베딩 모델·키워드/요약 설정이 그대로면 다음 기동부터는 .npy 만 읽습니다.
# (다시 만들 때만 bge-m3 를 올리므로 그때는 기동이 느립니다)
CASE_STORE_ENABLED=true
CASE_CSV_PATH=./data/cases.csv
CASE_TOP_K=5                      # 가져올 유사 사례 수
CASE_MIN_SCORE=0.5                # 이보다 덜 비슷한 사례는 반영하지 않습니다
CASE_BLEND_WEIGHT=0.2             # 0 이면 ④ 그대로, 1 이면 사례 투표만 사용 (6-1 측정으로 고른 값)
CASE_MODE=low_confidence

# 저장 방식. 검색 결과는 둘이 같습니다.
#   numpy    : data/cases.npy 를 메모리에서 계산 (추가 설치 없음 - Colab 테스트용)
#   pgvector : PostgreSQL + pgvector 테이블에서 검색 (PC·운영 서버용, README 1-6)
# Colab 은 PC 의 PostgreSQL 에 접속할 수 없으므로 numpy 로 두세요.
CASE_STORE_BACKEND=numpy
# pgvector 접속 정보. 비밀번호의 @ : / # % 같은 기호는 URL 인코딩 (@ -> %40)
#   예) CASE_PG_DSN=postgresql://postgres:비밀번호@localhost:5432/minwon
CASE_PG_DSN=
CASE_PG_TABLE=complaint_cases

# -----------------------------------------------------------------------------
# 게이트 (⑤ 의도 판정 기준)
# -----------------------------------------------------------------------------
# ⑤ Qwen 의 의도 판정은 6지선다입니다: 1~5(문의/접수/조회/수정/삭제) + 6(해당없음).
# "해당없음"으로 판정되면 카테고리 확정·도구 호출을 생략하고 반려합니다.
# 응답은 200 이고 status="rejected" + 안내 문구(answer)가 나갑니다.
#
# 카테고리(④)와는 무관한 판단입니다. "제가 어제 문의한 내용 보여줘"처럼 도로·환경 같은
# 특정 카테고리와 뚜렷이 겹치지 않는 문장도, 의도(조회)만 명확하면 정상 통과합니다.
# 반대로 "이 자동차 제가 접수했나요?"처럼 카테고리 어휘(자동차→국토교통)는 있어도
# 대상을 특정할 수 없는 문장은, 의도 자체(조회)는 여전히 명확하므로 이 게이트로는
# 걸러지지 않습니다 - 그런 경우는 ⑥ DB 조회 결과나 별도 슬롯 검사에서 처리해야 합니다.
#
# false 면 차단하지 않고 반려 사유만 기록합니다. (분류가 잘 되는지 관찰할 때 사용)
GATE_ENABLED=true

# -----------------------------------------------------------------------------
# ⑤ 판정 모델 (Qwen3.5 4B + QLoRA) - Colab T4 기준
# -----------------------------------------------------------------------------
LLM_MODEL=Qwen/Qwen3.5-4B

# Qwen3.5 는 기본이 '사고(thinking) 모드'라 답 앞에 <think>...</think> 를 먼저 씁니다.
# 의도/카테고리 판정은 다음 토큰 1개만 보므로 켜 두면 판정이 깨집니다. false 로 두세요.
LLM_ENABLE_THINKING=false

# 모델 저장소의 자체 코드를 실행해야 올라가는 모델만 true (Qwen·Llama·Gemma 는 false)
LLM_TRUST_REMOTE_CODE=false

# QLoRA 파인튜닝 어댑터 경로. 비우면 베이스 모델 + 프롬프트로만 동작합니다.
# 학습이 끝나면 여기에 어댑터 폴더(adapter_config.json 이 있는 폴더) 경로를 적으세요.
#   colab_train.ipynb 로 학습하면 adapters/<이름>/ 에 저장됩니다.
#   예) LLM_ADAPTER_PATH=adapters/v1_0929
LLM_ADAPTER_PATH=

# 4bit NF4 양자화(QLoRA 와 동일 설정).
# CUDA + bitsandbytes 가 있을 때만 적용되고, CPU 에서는 자동으로 꺼집니다.
# T4 에서 4B 를 올리려면 사실상 필수입니다. (false 면 fp16 으로 약 8GB)
LLM_LOAD_4BIT=true

# 4bit 연산 dtype. auto | bfloat16 | float16
# T4(Turing)는 bfloat16 을 지원하지 않습니다. auto 로 두면 자동으로 float16 을 고릅니다.
LLM_4BIT_COMPUTE_DTYPE=auto

# KV 캐시(CAG) - 고정 프리픽스(역할·도구·카테고리·의도 정의)를 한 번만 prefill 해 두고
# 요청마다 복사본을 재사용합니다. false 면 매 요청 전체 입력을 계산합니다.
LLM_KV_CACHE=true
# 처음 만들 때 캐시 사용/미사용 결과가 같은지 확인하고, 다르면 스스로 끕니다.
LLM_KV_CACHE_VERIFY=true

LLM_MAX_INPUT_CHARS=2000
LLM_MAX_NEW_TOKENS_TOOL=200       # 도구 호출 JSON 생성 길이
LLM_MAX_NEW_TOKENS_ANSWER=160     # '문의' 즉답 생성 길이
LLM_TEMPERATURE=0.0               # 0 이면 greedy (판정은 재현성이 중요)
LLM_TOP_P=0.9

# -----------------------------------------------------------------------------
# DEBUG 응답
# -----------------------------------------------------------------------------
# 위쪽 DEBUG=true 일 때만 분류 응답에 debug 블록이 실립니다.
#   - 추출 원문 / 키워드3개+요약 / ④ 후보 점수 / ⑤ 원시 출력
# 아래는 그때 같이 실어 보낼 임베딩 벡터 미리보기 개수입니다.
DEBUG_VECTOR_PREVIEW=8

# -----------------------------------------------------------------------------
# Google Colab T4 로 돌릴 때 권장값
# -----------------------------------------------------------------------------
# 아래 값들로 두면 T4(16GB)에 Qwen3.5-4B(4bit) + bge-m3 가 함께 올라갑니다.
#   DEVICE=auto
#   LLM_LOAD_4BIT=true
#   LLM_4BIT_COMPUTE_DTYPE=auto
#   LLM_ENABLE_THINKING=false
#   GATE_ENABLED=true
#   PRELOAD_MODELS=true
#   MODEL_CACHE_DIR=/content/drive/MyDrive/hf_cache
#
# MODEL_CACHE_DIR 을 구글 드라이브 경로로 두면 런타임이 끊겨도 8GB 를 다시 받지 않습니다.
# 설치·터널(Swagger 접속) 방법은 README.md 의 1-5. Colab T4 를 보세요.

# -----------------------------------------------------------------------------
# ⑥ 민원 찾기 - 번호 없이 "어제 넣은 가로등 민원"처럼 말할 때 (조회·수정·삭제)
# -----------------------------------------------------------------------------
TIMEZONE=Asia/Seoul               # 시점 표현("어제", "지난주")을 날짜로 바꿀 기준 시간대
SEARCH_SEMANTIC_MIN_SCORE=0.55    # keyword 가 글자 그대로 없을 때 의미 유사도 기준 (bge-m3)
